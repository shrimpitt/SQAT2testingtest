# ============================================================================
# SQAT Assignment 6 - Environment Variables Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file with real credentials to version control
# ============================================================================

# Local Testing
# Set to 'true' to run tests on BrowserStack, 'false' for local browser
RUN_REMOTE=false

# ============================================================================
# BrowserStack Credentials
# ============================================================================
# Get your credentials from: https://www.browserstack.com/accounts/profile
# DO NOT share these credentials or commit them to version control
BROWSERSTACK_USERNAME=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key

# ============================================================================
# Test Configuration
# ============================================================================
# Browser to use: chrome or edge
BROWSER=chrome

# Build name for BrowserStack (optional)
BROWSERSTACK_BUILD_NAME=SQAT_Assignment6_Build

# Session timeout in seconds
TIMEOUT=30
